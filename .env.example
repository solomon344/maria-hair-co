# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Never commit the filled-in file.

# ─── Database (Prisma / PostgreSQL) ──────────────────────────────
# Used by lib/prisma.ts and prisma.config.ts
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── Auth.js / NextAuth v5 ───────────────────────────────────────
# Required in production. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app. Needed when deploying behind a proxy / non-Vercel host.
# AUTH_URL="https://marieahairco.com"
# AUTH_TRUST_HOST=true

# ─── Email ───────────────────────────────────────────────────────
# Magic-link sign-in (lib/auth.ts, Nodemailer provider). SMTP connection string.
# Gmail example (use an App Password, not your normal password):
EMAIL_SERVER="smtp://you@gmail.com:APP_PASSWORD@smtp.gmail.com:587"
# Sender address for sign-in links and admin emails
EMAIL_FROM="you@gmail.com"
# Gmail App Password used by app/api/admin/send-email (hard-coded to smtp.gmail.com)
EMAIL_PASSWORD=""

# ─── Admin ───────────────────────────────────────────────────────
# Email of the admin account. Checked by the admin page and /api/admin/* routes.
# NOTE: NEXT_PUBLIC_ values are bundled into client JS, so this is visible to visitors.
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# ─── App URL ─────────────────────────────────────────────────────
# Used for shared-cart links and email CTA buttons
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── ModemPay (payments) ─────────────────────────────────────────
# Server-side key used to verify payments (lib/modempay.ts)
MODEMPAY_SECRET_KEY=""
# Public key used by the inline checkout on app/checkout/page.tsx
NEXT_PUBLIC_MODEMPAY_PUBLIC_KEY=""
# Webhook secret from ModemPay dashboard → Developers → Webhooks.
# Webhook URL to register there: https://<your-domain>/api/payment/webhook
MODEMPAY_WEBHOOK_SECRET=""

# ─── EdgeStore (image uploads) ───────────────────────────────────
# Read automatically by @edgestore/server — get them from https://dashboard.edgestore.dev
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# ─── Contentful (planned, not wired up yet — see CONTENTFUL.md) ──
# CONTENTFUL_SPACE_ID=""
# CONTENTFUL_ACCESS_TOKEN=""
